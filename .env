# ===================================
# .env


# Logging
LOG_LEVEL=INFO

# Training
CUDA_VISIBLE_DEVICES=0  # GPU device ID
TORCH_NUM_THREADS=4     # Number of CPU threads

# Paths
LOG_DIR=logs
VIDEO_DIR=videos
MODEL_DIR=models
TENSORBOARD_DIR=tensorboard

# Optional: HuggingFace Hub (for model sharing)
# HF_TOKEN=your_token_here